# Identity (all values are examples)
BOT_DISPLAY_NAME=QQ AI 助手
BOT_PERSONA_NAME=小助手
BOT_PERSONA=你是群聊里的 AI 助手。说话自然、友善、简洁，不暴露内部实现。
BOT_TRIGGER_WORDS=小助手,助手

# Privacy: comma-separated group IDs. IDs never leave the bot host.
BLOCKED_GROUP_IDS=
ADMIN_QQ_IDS=

# Local chain
ONEBOT_WS=ws://127.0.0.1:3001
OPENCLAW_URL=http://127.0.0.1:29306/v1/chat/completions
OPENCLAW_GATEWAY_TOKEN=replace-with-local-gateway-token
CEYLAN_OPENCLAW_CONFIG=/home/ubuntu/.openclaw/openclaw.json
# Optional; auto-discovers onebot11_*.json when omitted.
CEYLAN_ONEBOT_CONFIG=

# Optional web control plane
BOT_CONTROL_BASE_URL=https://bot-console.example.com
CEYLAN_BOT_TOKEN=generate-a-random-64-character-secret

# Reply and resource limits
MAX_HISTORY=12
ACTIVE_GROUP_CONTEXT_LIMIT=15
PERIODIC_REVIEW_INTERVAL_SECONDS=10800
GROUP_MEMORY_COMPACT_INTERVAL_SECONDS=18000
GROUP_MEMORY_MIN_NEW_MESSAGES=80
CEYLAN_MODEL_CONCURRENCY=2
CEYLAN_MAX_PENDING=128

# Vision (optional)
USE_DIRECT_MIMO_VISION=0
MIMO_VISION_BASE_URL=
MIMO_VISION_API_KEY=
MIMO_VISION_MODEL=
