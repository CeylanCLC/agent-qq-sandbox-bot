SITE_DISPLAY_NAME=AI Bot Console
SITE_TAGLINE=BOT OPERATIONS
BOT_DISPLAY_NAME=QQ AI 助手
BOT_NODE_LABEL=机器人节点

CEYLAN_ADMIN_USER=admin
# Generate with: python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('change-me'))"
CEYLAN_ADMIN_HASH=replace-with-werkzeug-password-hash
CEYLAN_SECRET_KEY=replace-with-a-long-random-value
CEYLAN_BOT_TOKEN=must-match-the-bot-host

CEYLAN_DB_PATH=/var/lib/ceylan-status/visitors.db
CEYLAN_BOT_STATUS_FILE=/var/lib/ceylan-status/bot_status.json
CEYLAN_CLIPBOARD_DB=/var/lib/ceylan-status/clipboard.db
CEYLAN_TELEMETRY_DB=/var/lib/ceylan-status/bot_telemetry.db
CEYLAN_CONTROL_DB=/var/lib/ceylan-status/bot_control.db
CEYLAN_KEYS_DB=/var/lib/ceylan-status/keys_v5.db
CEYLAN_FUN_DB=/var/lib/ceylan-status/bot_fun.db
